# Copy to .env for your own reference, but export these variables in your shell.
# Never commit .env. Never put these values in browser/front-end code.
USCIS_CLIENT_ID=replace_me
USCIS_CLIENT_SECRET=replace_me

# sandbox (default) or production. Production URLs are supplied after approval.
USCIS_ENVIRONMENT=sandbox
# USCIS_BASE_URL=https://production-url-provided-by-uscis.example
# USCIS_TOKEN_URL=https://production-token-url-provided-by-uscis.example

# Safety ceilings. The sandbox allows 1,000 requests/day and 5 requests/second.
USCIS_MAX_DAILY_REQUESTS=1000
USCIS_REQUESTS_PER_SECOND=5
USCIS_DATABASE_PATH=data/cases.sqlite3

